<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title — SDE Entrevista</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/layout.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    
</head>
<body>

    <div class="sde-shell">

        <!-- 🔥 Overlay -->
        <div id="sdeOverlay" class="sde-overlay" onclick="toggleSidebar(false)"></div>

        <aside class="sde-sidebar" id="sdeSidebar">

            <div class="sde-brand">
                <div class="sde-brand-icon">🧠</div>
                <div>
                    <div class="sde-brand-text">SDE Interview</div>
                    <div class="sde-brand-sub">Powered by Groq AI</div>
                </div>
            </div>

            <div class="sde-user-block">
                <img class="sde-avatar"
                     src="@(Session["avatar"] ?? "https://api.dicebear.com/7.x/adventurer/svg?seed=default")"
                     alt="Avatar" />
                <div style="overflow:hidden;">
                    <div class="sde-user-name">@Session["nombre_usuario"]</div>
                    <div class="sde-user-email">@Session["USUARIO"]</div>
                </div>
            </div>

            <nav class="sde-nav">

                <div class="sde-nav-label">Principal</div>

                <a href="@Url.Action("Index","Home")"
                   class="sde-nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    Dashboard
                </a>

                <a href="@Url.Action("Index","Simulacion")"
                   class="sde-nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Simulacion" ? "active" : "")">
                    <i class="bi bi-play-circle"></i>
                    Nueva Entrevista
                </a>

                

                <a href="@Url.Action("Index","Plan")"
                   class="sde-nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Plan" ? "active" : "")">
                    <i class="bi bi-calendar-check"></i>
                    Plan de Entrenamiento
                </a>

                <a href="@Url.Action("Index","Chatbot")"
                   class="sde-nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Chatbot" ? "active" : "")">
                    <i class="bi bi-robot"></i>
                    EntrevistBot
                </a>

                <div class="sde-nav-label">Cuenta</div>

                <a href="@Url.Action("Index","Perfil")"
                   class="sde-nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Perfil" ? "active" : "")">
                    <i class="bi bi-person-circle"></i>
                    Mi Perfil
                </a>

                <a href="@Url.Action("Logout","Auth")" class="sde-nav-item danger">
                    <i class="bi bi-box-arrow-left"></i>
                    Cerrar Sesión
                </a>

            </nav>

            <div class="sde-sidebar-footer">
                <a href="@Url.Action("Index","Simulacion")" class="sde-cta-btn">
                    <i class="bi bi-plus-lg"></i>
                    Nueva Entrevista
                </a>
            </div>

        </aside>

        <main class="sde-main">

            <header class="sde-topbar">
                <button class="btn p-0 d-md-none text-white me-2"
                        onclick="toggleSidebar(true)">
                    <i class="bi bi-list fs-5"></i>
                </button>

                <span class="sde-topbar-title">@ViewBag.Title</span>

                <span class="sde-topbar-badge">
                    <i class="bi bi-circle-fill" style="font-size:7px; color: var(--sde-success);"></i>
                    @Session["nombre_usuario"]
                </span>
            </header>

            <div class="sde-content sde-fadein">
                @RenderBody()
            </div>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

    <script>
        function toggleSidebar(open) {
            const sidebar = document.getElementById('sdeSidebar');
            const overlay = document.getElementById('sdeOverlay');
            const body = document.body;

            if (open) {
                sidebar.classList.add('open');
                overlay.classList.add('active');
                body.classList.add('no-scroll');
            } else {
                sidebar.classList.remove('open');
                overlay.classList.remove('active');
                body.classList.remove('no-scroll');
            }
        }
    </script>

</body>
</html>