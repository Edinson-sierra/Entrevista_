<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>SDE Entrevista</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f6fa;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
        }

        .chat-box {
            max-height: 500px;
            overflow-y: auto;
        }

        .msg-user {
            text-align: right;
        }

        .msg-ai {
            text-align: left;
        }

        .bubble {
            display: inline-block;
            padding: 10px 15px;
            border-radius: 15px;
            margin: 5px;
            max-width: 70%;
        }

        .user {
            background: #007bff;
            color: white;
        }

        .ai {
            background: #e4e6eb;
        }
    </style>
</head>
<body>

    <div class="d-flex">

        <!-- SIDEBAR -->
        <div class="bg-dark text-white p-3 sidebar">

            <div class="text-center mb-3">
                <img src="@Session["avatar"]"
                     style="width:80px;height:80px;border-radius:50%;" />

                <h5>@Session["nombre_usuario"]</h5>
            </div>

            <hr />

            <ul class="nav flex-column">
                <li><a href="/Home" class="nav-link text-white">Dashboard</a></li>
                <li><a href="/Simulacion" class="nav-link text-white">Simulación</a></li>
                <li><a href="/Perfil" class="nav-link text-white">Perfil</a></li>
                <li><a href="/Auth/Logout" class="nav-link text-danger">Salir</a></li>
            </ul>

        </div>

        <!-- CONTENIDO -->
        <div class="p-4 w-100">
            @RenderBody()
        </div>

    </div>

</body>
</html>