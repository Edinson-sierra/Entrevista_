@model Entrevista.ViewModels.SimulacionViewModel

@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h2>Iniciar Simulación</h2>

<div class="card p-4">

    @using (Html.BeginForm("Iniciar", "Simulacion", FormMethod.Post))
    {
        <div class="form-group">
            <label>Tema</label>
            @Html.DropDownListFor(x => x.TemaSeleccionado, Model.Temas, "Seleccione", new { @class = "form-control" })
        </div>

        <div class="form-group mt-3">
            <label>Dificultad</label>
            @Html.DropDownListFor(x => x.DificultadSeleccionada, Model.Dificultades, "Seleccione", new { @class = "form-control" })
        </div>

        <br />

        <button class="btn btn-primary">Iniciar Entrevista</button>
    }
</div>
