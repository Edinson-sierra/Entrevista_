@model Entrevista.ViewModels.DashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Dashboard</h2>

<div class="row">

    <div class="col-md-4">
        <div class="card p-3">
            <h5>Total Entrevistas</h5>
            <h2>@Model.TotalEntrevistas</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <h5>Promedio</h5>
            <h2>@Model.PromedioPuntaje</h2>
        </div>
    </div>

</div>

<hr />

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Puntaje</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.UltimosResultados)
        {
            <tr>
                <td>@item.EntrevistaId</td>
                <td>@item.Puntaje</td>
                <td>
                    <a href="/Resultado/Index?id=@item.EntrevistaId" class="btn btn-sm btn-info">Ver</a>
                </td>
            </tr>
        }
    </tbody>
</table>