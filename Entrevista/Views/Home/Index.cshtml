@model Entrevista.ViewModels.DashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2 class="mb-4">Dashboard</h2>

    <!-- 🔥 CARDS PRINCIPALES -->
    <div class="row">

        <!-- Total entrevistas -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 text-center p-3">
                <h6 class="text-muted">Entrevistas</h6>
                <h2 class="fw-bold">@Model.TotalEntrevistas</h2>
            </div>
        </div>

        <!-- Promedio -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 text-center p-3">
                <h6 class="text-muted">Promedio</h6>
                <h2 class="fw-bold">@Model.PromedioPuntaje / 10</h2>
            </div>
        </div>

        <!-- Nivel -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 text-center p-3">
                <h6 class="text-muted">Nivel</h6>

                @{
                    var badgeClass = "bg-secondary";

                    if (Model.Nivel == "Senior") { badgeClass = "bg-success"; }
                    else if (Model.Nivel == "Mid") { badgeClass = "bg-warning text-dark"; }
                    else { badgeClass = "bg-danger"; }
                }

                <span class="badge @badgeClass p-2">@Model.Nivel</span>
            </div>
        </div>

        <!-- Última actividad -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 text-center p-3">
                <h6 class="text-muted">Última entrevista</h6>
                <h5>
                    @(Model.UltimaFecha.HasValue
                        ? Model.UltimaFecha.Value.ToString("dd/MM/yyyy")
                        : "Sin registros")
                </h5>
            </div>
        </div>

    </div>

    <!-- 🔥 BOTÓN PRINCIPAL -->
    <div class="mb-4">
        <a href="@Url.Action("Index", "Simulacion")" class="btn btn-primary">
            + Nueva Entrevista
        </a>
    </div>

    <!-- 🔥 TABLA DE ENTREVISTAS -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0">Últimas entrevistas</h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Tema</th>
                        <th>Dificultad</th>
                        <th>Puntaje</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.UltimasEntrevistas != null && Model.UltimasEntrevistas.Any())
                    {
                        foreach (var item in Model.UltimasEntrevistas)
                        {
                            <tr>
                                <td>
                                    @(item.Fecha.HasValue
        ? item.Fecha.Value.ToString("dd/MM/yyyy")
        : "-")
                                </td>

                                <td>@item.Tema</td>

                                <td>
                                    @{
                                        var badgeDif = "bg-secondary";

                                        if (item.Dificultad == "Alta") { badgeDif = "bg-danger"; }
                                        else if (item.Dificultad == "Media") { badgeDif = "bg-warning text-dark"; }
                                        else if (item.Dificultad == "Baja") { badgeDif = "bg-success"; }

                                    }

                                    <span class="badge @badgeDif">@item.Dificultad</span>
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @item.Puntaje / 10
                                    </span>
                                </td>

                                <td>
                                    <a href="@Url.Action("Index", "Resultado", new { id = item.EntrevistaId })"
                                       class="btn btn-sm btn-outline-primary">
                                        Ver resultado
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center p-4">
                                No hay entrevistas registradas
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>