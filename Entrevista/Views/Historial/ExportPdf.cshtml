@{
    Layout = null;
    var entrevistas = ViewBag.Entrevistas as List<Entrevista_DATA.Entrevista>;
    var fechaExportacion = ViewBag.FechaExportacion as DateTime?;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Historial de Simulaciones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { font-family: Arial, sans-serif; padding: 40px; background: #fff; }
        .header { border-bottom: 3px solid #6366f1; padding-bottom: 20px; margin-bottom: 30px; }
        .header h1 { color: #333; margin: 0; font-size: 28px; }
        .header p { color: #666; margin: 8px 0 0 0; }
        .simulacion { margin-bottom: 40px; page-break-inside: avoid; }
        .simulacion h2 { color: #555; font-size: 20px; margin-bottom: 15px; padding-bottom: 8px; border-bottom: 1px solid #eee; }
        .simulacion-meta { color: #666; font-size: 14px; margin-bottom: 15px; }
        .score { display: inline-block; padding: 8px 16px; border-radius: 8px; font-weight: bold; margin-left: 10px; }
        .score-high { background: #dcfce7; color: #16a34a; }
        .score-medium { background: #fef3c7; color: #d97706; }
        .score-low { background: #fee2e2; color: #dc2626; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; font-size: 13px; }
        th { background: #6366f1; color: white; font-weight: 600; }
        tr:nth-child(even) { background: #f9f9f9; }
        .badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .badge-green { background: #dcfce7; color: #16a34a; }
        .badge-red { background: #fee2e2; color: #dc2626; }
        .btn-print { display: none; }
        @media print {
            body { padding: 20px; }
            .btn-print { display: none !important; }
            .no-print { display: none !important; }
        }
        .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #eee; text-align: center; color: #999; font-size: 12px; }
    </style>
</head>
<body>
    <div class="btn-print no-print" style="text-align: center; margin-bottom: 20px;">
        <button onclick="window.print()" class="btn btn-primary">
            <i class="bi bi-printer"></i> Imprimir / Guardar como PDF
        </button>
        <a href="@Url.Action("Index", "Historial")" class="btn btn-secondary">Volver</a>
    </div>

    <div class="header">
        <h1>Historial de Simulaciones</h1>
        <p>Fecha de exportación: @(fechaExportacion?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</p>
    </div>

    @if (entrevistas != null && entrevistas.Any())
    {
        foreach (var entrevista in entrevistas)
        {
            var preguntas = entrevista.Preguntas.OrderBy(p => p.id_pregunta).ToList();
            var resultados = entrevista.Resultado.OrderBy(r => r.id_resultado).ToList();
            var respuestas = entrevista.Respuestas.ToList();

            double promedio = 0;
            var count = 0;
            for (int i = 0; i < preguntas.Count; i++)
            {
                var puntaje = i < resultados.Count ? resultados[i].puntaje_total ?? 0 : 0;
                promedio += puntaje;
                count++;
            }
            promedio = count > 0 ? Math.Round(promedio / count, 1) : 0;

            var scoreClass = promedio >= 8 ? "score-high" : promedio >= 5 ? "score-medium" : "score-low";

            <div class="simulacion">
                <h2>
                    @entrevista.Temas?.nombre_tema
                    <span class="score @scoreClass">@promedio.ToString("0.0")/10</span>
                </h2>
                <div class="simulacion-meta">
                    <strong>Fecha:</strong> @(entrevista.fecha_entrevista?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                </div>

                <table>
                    <thead>
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th>Pregunta</th>
                            <th>Tu respuesta</th>
                            <th style="width: 80px;">Puntaje</th>
                            <th style="width: 100px;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < preguntas.Count; i++)
                        {
                            var pregunta = preguntas[i];
                            var respuesta = respuestas.FirstOrDefault(r => r.preguntas_id_pregunta == pregunta.id_pregunta);
                            var puntaje = i < resultados.Count ? resultados[i].puntaje_total ?? 0 : 0;
                            var esCorrecto = puntaje >= 5;

                            <tr>
                                <td>@(i + 1)</td>
                                <td>@pregunta.texto_pregunta</td>
                                <td>@(respuesta?.respuesta_usuario ?? "Sin respuesta")</td>
                                <td>@puntaje/10</td>
                                <td><span class="badge @(esCorrecto ? "badge-green" : "badge-red")">@(esCorrecto ? "Correcto" : "Incorrecto")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <div class="footer">
        Generado por SDE Interview - Powered by Groq AI
    </div>
</body>
</html>