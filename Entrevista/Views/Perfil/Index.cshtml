@model Entrevista.ViewModels.PerfilViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Mi Perfil</h2>

<div class="row">

    <div class="col-md-4 text-center">
        <img src="@Model.AvatarUrl" style="width:150px;border-radius:50%;" />

        <br /><br />

        <a href="/Perfil/GenerarAvatar" class="btn btn-secondary">
            Cambiar Avatar
        </a>
    </div>

    <div class="col-md-8">

        @using (Html.BeginForm("Guardar", "Perfil", FormMethod.Post))
        {
            <div class="form-group">
                <label>Nombre</label>
                @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", disabled = "disabled" })
            </div>

            <div class="form-group mt-2">
                <label>Email</label>
                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", disabled = "disabled" })
            </div>

            <div class="form-group mt-2">
                <label>Bio</label>
                @Html.TextAreaFor(x => x.Bio, new { @class = "form-control", rows = 4 })
            </div>

            <br />

            <button class="btn btn-primary">Guardar</button>
        }
    </div>

</div>