@model Entrevista.ViewModels.ResultadoViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Resultado de Entrevista";

    var headerClass = Model.Nivel == "Senior" ? "senior"
                    : Model.Nivel == "Mid" ? "mid"
                    : "junior";

    var scoreClass = Model.Promedio >= 8 ? "high"
                    : Model.Promedio >= 5 ? "medium"
                    : "low";

    var scoreColor = Model.Promedio >= 8 ? "var(--sde-success)"
                    : Model.Promedio >= 5 ? "var(--sde-warning)"
                    : "var(--sde-danger)";

    var nivelColor = Model.Nivel == "Senior" ? "sde-badge-green"
                    : Model.Nivel == "Mid" ? "sde-badge-yellow"
                    : "sde-badge-red";
}
@section Styles {
    <link href="~/Content/resultado.css" rel="stylesheet" />
}

    @* ============================================================
        HEADER
        ============================================================ *@
    <div class="result-header @headerClass">
        <div class="result-header-grid">

            <div>
                <div style="font-size: 22px; font-weight: 800; margin-bottom: 14px;">
                    Entrevista completada
                </div>

                <div class="result-meta">
                    <div class="result-meta-item">
                        <i class="bi bi-calendar3"></i>
                        <strong>@(Model.Fecha?.ToString("dd/MM/yyyy HH:mm") ?? "—")</strong>
                    </div>
                    <div class="result-meta-item">
                        <i class="bi bi-book"></i>
                        <strong>@Model.Tema</strong>
                    </div>
                    <div class="result-meta-item">
                        <i class="bi bi-speedometer2"></i>
                        <strong>@Model.Dificultad</strong>
                    </div>
                    <div class="result-meta-item">
                        <i class="bi bi-circle-fill" style="font-size: 8px; color: var(--sde-success);"></i>
                        <strong>@Model.Estado</strong>
                    </div>
                </div>

                <div class="result-actions">
                    <a href="@Url.Action("Index","Home")" class="sde-btn sde-btn-ghost">
                        <i class="bi bi-arrow-left"></i>
                        Dashboard
                    </a>
                    <a href="@Url.Action("Index","Simulacion")" class="sde-btn sde-btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        Nueva entrevista
                    </a>
                </div>
            </div>

            @* Score *@
            <div class="score-circle-wrap">
                <div class="score-circle @scoreClass">
                    <div class="score-number" style="color:@scoreColor;">
                        @Model.Promedio.ToString("0.0")
                    </div>
                    <div class="score-denom">/ 10</div>
                </div>
                <span class="sde-badge @nivelColor score-nivel">@Model.Nivel</span>
            </div>

        </div>
    </div>

    @* ============================================================
        DESGLOSE
        ============================================================ *@
    <div style="font-size:16px; font-weight:700; margin-bottom:16px;">
        <i class="bi bi-list-check" style="color:var(--sde-accent); margin-right:6px;"></i>
        Desglose por pregunta
    </div>

    <div class="qa-grid">
        @for (int i = 0; i < Model.Detalles.Count; i++)
        {
            var item = Model.Detalles[i];

            var sBadge = item.Puntaje >= 8 ? "sde-badge-green"
                       : item.Puntaje >= 5 ? "sde-badge-yellow"
                       : "sde-badge-red";

            var sBarColor = item.Puntaje >= 8 ? "var(--sde-success)"
                           : item.Puntaje >= 5 ? "var(--sde-warning)"
                           : "var(--sde-danger)";

            <div class="qa-card" id="qaCard_@i">

                <div class="qa-card-header" onclick="toggleQA(@i)">
                    <div class="qa-num">@(i + 1)</div>
                    <div class="qa-question-preview">@item.Pregunta</div>
                    <span class="sde-badge @sBadge qa-score-badge">
                        @item.Puntaje/10
                    </span>
                    <i class="bi bi-chevron-down qa-chevron"></i>
                </div>

                <div class="qa-card-body">

                    @* Barra *@
                    <div class="qa-score-bar">
                        <div class="qa-score-bar-fill"
                             style="width:@((item.Puntaje * 10).ToString())%; background:@sBarColor;">
                        </div>
                    </div>

                    @* Pregunta *@
                    <div class="qa-section-label">Pregunta</div>
                    <div class="qa-text">@item.Pregunta</div>

                    @* Respuesta *@
                    <div class="qa-section-label">Tu respuesta</div>
                    <div class="qa-text answer">
                        @(string.IsNullOrWhiteSpace(item.Respuesta)
                        ? "Sin respuesta registrada"
                        : item.Respuesta)
                    </div>

                    @* Feedback *@
                    @if (!string.IsNullOrWhiteSpace(item.Observacion))
                    {
                        <div class="qa-section-label">Feedback de la IA</div>
                        <div class="qa-feedback">
                            <i class="bi bi-robot" style="color:var(--sde-accent); margin-right:6px;"></i>
                            @item.Observacion
                        </div>
                    }

                </div>
            </div>
        }
    </div>

    @* ============================================================
        RECOMENDACIÓN FINAL
        ============================================================ *@
    @if (!string.IsNullOrWhiteSpace(Model.RecomendacionFinal))
    {
        <div class="recomendacion-card">
            <h4>
                <i class="bi bi-stars"></i>
                Análisis y plan de mejora — IA
            </h4>
            <div class="recomendacion-content">
                @Html.Raw(Model.RecomendacionFinal)
            </div>
        </div>
    }

    @section Scripts {
        <script>
            function toggleQA(i) {
                var card = document.getElementById('qaCard_' + i);
                if (card) card.classList.toggle('open');
            }

            document.addEventListener('DOMContentLoaded', function () {
                var first = document.getElementById('qaCard_0');
                if (first) first.classList.add('open');
            });
        </script>
    }