@model Entrevista.ViewModels.PlanViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Plan de Entrenamiento";
    var fecha = Model.Fecha != default(DateTime) ? Model.Fecha : DateTime.Now;
}
@section Styles {
    <link href="~/Content/plan.css" rel="stylesheet" />

}

<div class="plan-pro-wrap">

    <div class="plan-topbar">
        <div class="plan-origin-badge">
            <span class="live-dot"></span>
            Groq AI · @fecha.ToString("dd MMM yyyy")
            @if (!string.IsNullOrWhiteSpace(Model.Tema))
            {<span class="plan-badge-sep">·</span><span>@Model.Tema</span>}
            @if (!string.IsNullOrWhiteSpace(Model.Dificultad))
            {<span class="plan-badge-sep">·</span><span>@Model.Dificultad</span>}
        </div>
        <div style="display:flex;gap:8px;">
            <a href="@Url.Action("Historial","Plan")" class="sde-btn sde-btn-ghost" style="padding:6px 14px;font-size:13px;">
                <i class="bi bi-clock-history"></i> Historial
            </a>
            <button class="sde-btn sde-btn-ghost" style="padding:6px 14px;font-size:13px;" onclick="window.print()">
                <i class="bi bi-printer"></i> Imprimir
            </button>
        </div>
    </div>

    <div class="plan-hero">
        <div class="plan-hero-icon">📅</div>
        <h1 class="plan-hero-title">Tu calendario de estudio</h1>
        <p class="plan-hero-sub">La IA organizó en fechas concretas los temas que necesitas reforzar. Marca cada día al completarlo.</p>
        <div class="plan-stats-row">
            <div class="plan-stat"><span class="plan-stat-num" id="statDias">—</span><span class="plan-stat-label">días de estudio</span></div>
            <div class="plan-stat"><span class="plan-stat-num" id="statTemas">—</span><span class="plan-stat-label">temas a reforzar</span></div>
            <div class="plan-stat"><span class="plan-stat-num" id="statCompletados">0</span><span class="plan-stat-label">completados</span></div>
        </div>
    </div>

    <div class="plan-empty" id="planEmpty">
        <div class="plan-empty-icon">🏆</div>
        <div class="plan-empty-title">¡Excelente desempeño!</div>
        <div class="plan-empty-sub">No identificamos áreas que necesites reforzar. ¡Sigue practicando!</div>
    </div>

    <div class="plan-calendar" id="planCalendar">
        <div class="plan-loading"><div class="plan-spinner"></div><span>Construyendo tu calendario...</span></div>
    </div>

    <script type="application/json" id="planData">@Html.Raw(Model.Recomendacion)</script>

    <div class="plan-actions-bottom">
        <a href="@Url.Action("Index","Home")" class="sde-btn sde-btn-ghost"><i class="bi bi-arrow-left"></i> Dashboard</a>
        <a href="@Url.Action("Index","Simulacion")" class="sde-btn sde-btn-primary"><i class="bi bi-play-circle"></i> Practicar ahora</a>
    </div>
</div>

@section Scripts {
    <script>
(function () {

    var rawEl = document.getElementById('planData');
    var calendar = document.getElementById('planCalendar');
    var emptyEl  = document.getElementById('planEmpty');

    var plan = null;

    try {
        var raw = rawEl ? rawEl.textContent.trim() : '';

        // 🔥 LIMPIEZA MEJORADA (CLAVE)
        raw = raw
            .replace(/```json/gi, '')
            .replace(/```/g, '')
            .replace(/\n/g, '')
            .trim();

        plan = JSON.parse(raw);

    } catch (e) {

        console.error("❌ Error parseando JSON:", e);

        // 🔥 FALLBACK PROFESIONAL
        calendar.innerHTML = `
        <div class="plan-card plan-card-fallback">
            <div class="plan-content">
                <pre style="white-space: pre-wrap; font-size: 13px;">
${rawEl ? rawEl.textContent : 'Sin datos'}
                </pre>
            </div>
        </div>`;

        return;
    }

    // ── Validación ──
    if (!plan || !plan.dias || !Array.isArray(plan.dias) || plan.dias.length === 0) {
        calendar.style.display = 'none';
        emptyEl.style.display  = 'flex';
        document.getElementById('statDias').textContent  = '0';
        document.getElementById('statTemas').textContent = '0';
        return;
    }

    // ── Stats ──
    var totalTemas = 0;
    plan.dias.forEach(d => totalTemas += (d.temas || []).length);

    document.getElementById('statDias').textContent  = plan.dias.length;
    document.getElementById('statTemas').textContent = totalTemas;

    var html = '';

    if (plan.resumen) {
        html += `
        <div class="plan-resumen-global">
            <i class="bi bi-stars"></i>
            ${escHtml(plan.resumen)}
        </div>`;
    }

    plan.dias.forEach(function (dia, idx) {

        var nivelClass =
            dia.nivel === 'alto' ? 'nivel-alto' :
            dia.nivel === 'medio' ? 'nivel-medio' : 'nivel-bajo';

        var nivelLabel =
            dia.nivel === 'alto' ? 'Prioridad alta' :
            dia.nivel === 'medio' ? 'Prioridad media' : 'Repaso ligero';

        html += `
        <div class="plan-day-card" data-idx="${idx}">

            <div class="plan-day-header">
                <div class="plan-day-left">
                    <div class="plan-day-num">Día ${idx + 1}</div>
                    <div class="plan-day-fecha">${escHtml(dia.fecha || '')}</div>
                </div>

                <div class="plan-day-right">
                    ${dia.titulo ? `<div class="plan-day-titulo">${escHtml(dia.titulo)}</div>` : ''}
                    <div class="plan-day-meta">
                        <span class="plan-nivel-badge ${nivelClass}">${nivelLabel}</span>
                        ${dia.duracion_estimada ? `<span class="plan-duracion">${escHtml(dia.duracion_estimada)}</span>` : ''}
                    </div>
                </div>

                <button class="plan-check-btn" onclick="marcarDia(this,${idx})">
                    ✔
                </button>
            </div>

            <div class="plan-day-body">
                <ul class="plan-temas-list">
        `;

        (dia.temas || []).forEach(function (tema) {

            html += `
            <li class="plan-tema-item">
                <div class="plan-tema-top">
                    <span class="plan-tema-nombre">${escHtml(tema.nombre || '')}</span>
                </div>

                ${tema.descripcion ? `<p>${escHtml(tema.descripcion)}</p>` : ''}

                ${(tema.recursos || []).length > 0 ? `
                    <ul>
                        ${tema.recursos.map(r => `<li>${escHtml(r)}</li>`).join('')}
                    </ul>
                ` : ''}
            </li>`;
        });

        html += `</ul>`;

        if (dia.recomendacion) {
            html += `
            <div class="plan-day-rec">
                💡 ${escHtml(dia.recomendacion)}
            </div>`;
        }

        html += `</div></div>`;
    });

    calendar.innerHTML = html;

    cargarEstado();

    function escHtml(str) {
        return String(str || '')
            .replace(/&/g,'&amp;')
            .replace(/</g,'&lt;')
            .replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;');
    }

})();

function marcarDia(btn) {
    var card = btn.closest('.plan-day-card');
    card.classList.toggle('completado');
    guardarEstado();
    actualizarContador();
}

function guardarEstado() {
    var estados = [];
    document.querySelectorAll('.plan-day-card').forEach(c => {
        estados.push(c.classList.contains('completado'));
    });
    localStorage.setItem('plan_estados_@Model.Id', JSON.stringify(estados));
}

function cargarEstado() {
    var raw = localStorage.getItem('plan_estados_@Model.Id');
    if (!raw) return;

    var estados = JSON.parse(raw);
    document.querySelectorAll('.plan-day-card').forEach((c, i) => {
        if (estados[i]) c.classList.add('completado');
    });

    actualizarContador();
}

function actualizarContador() {
    var completados = document.querySelectorAll('.plan-day-card.completado').length;
    document.getElementById('statCompletados').textContent = completados;
}
    </script>
}
