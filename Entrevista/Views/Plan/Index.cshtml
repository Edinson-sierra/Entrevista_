@model Entrevista.ViewModels.PlanViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Plan de Entrenamiento";
    var fecha = Model.Fecha != default(DateTime) ? Model.Fecha : DateTime.Now;
}
@section Styles {
    <link href="~/Content/plan.css" rel="stylesheet" />

}

<div class="plan-pro-wrap">

    <div class="plan-topbar">
        <div class="plan-origin-badge">
            <span class="live-dot"></span>
            Groq AI · @fecha.ToString("dd MMM yyyy")
            @if (!string.IsNullOrWhiteSpace(Model.Tema))
            {<span class="plan-badge-sep">·</span><span>@Model.Tema</span>}
            @if (!string.IsNullOrWhiteSpace(Model.Dificultad))
            {<span class="plan-badge-sep">·</span><span>@Model.Dificultad</span>}
        </div>
        <div style="display:flex;gap:8px;">
            <a href="@Url.Action("Historial","Plan")" class="sde-btn sde-btn-ghost" style="padding:6px 14px;font-size:13px;">
                <i class="bi bi-clock-history"></i> Historial
            </a>
            <button class="sde-btn sde-btn-ghost" style="padding:6px 14px;font-size:13px;" onclick="window.print()">
                <i class="bi bi-printer"></i> Imprimir
            </button>
        </div>
    </div>

    <div class="plan-hero">
        <div class="plan-hero-icon">📅</div>
        <h1 class="plan-hero-title">Tu calendario de estudio</h1>
        <p class="plan-hero-sub">La IA organizó en fechas concretas los temas que necesitas reforzar. Marca cada día al completarlo.</p>
        <div class="plan-stats-row">
            <div class="plan-stat"><span class="plan-stat-num" id="statDias">—</span><span class="plan-stat-label">días de estudio</span></div>
            <div class="plan-stat"><span class="plan-stat-num" id="statTemas">—</span><span class="plan-stat-label">temas a reforzar</span></div>
            <div class="plan-stat"><span class="plan-stat-num" id="statCompletados">0</span><span class="plan-stat-label">completados</span></div>
        </div>
    </div>

    <div class="plan-empty" id="planEmpty">
        <div class="plan-empty-icon">🏆</div>
        <div class="plan-empty-title">¡Excelente desempeño!</div>
        <div class="plan-empty-sub">No identificamos áreas que necesites reforzar. ¡Sigue practicando!</div>
    </div>

    <div class="plan-calendar" id="planCalendar">
        <div class="plan-loading"><div class="plan-spinner"></div><span>Construyendo tu calendario...</span></div>
    </div>

    <script type="application/json" id="planData">@Html.Raw(Model.Recomendacion)</script>

    <div class="plan-actions-bottom">
        <a href="@Url.Action("Index","Home")" class="sde-btn sde-btn-ghost"><i class="bi bi-arrow-left"></i> Dashboard</a>
        <a href="@Url.Action("Index","Simulacion")" class="sde-btn sde-btn-primary"><i class="bi bi-play-circle"></i> Practicar ahora</a>
    </div>
</div>

@section Scripts {
    <script>
(function(){
    var M=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    var DC=['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
    var rawEl=document.getElementById('planData');
    var cal=document.getElementById('planCalendar');
    var emp=document.getElementById('planEmpty');
    var plan=null;

    try {
        var raw=(rawEl?rawEl.textContent:'').trim()
            .replace(/^```json\s*/i,'').replace(/^```\s*/i,'').replace(/```\s*$/i,'').trim();
        plan=JSON.parse(raw);
    } catch(e) {
        cal.innerHTML='<div class="plan-card-fallback">'+(rawEl?rawEl.textContent:'')+'</div>';
        return;
    }

    if(!plan||!plan.dias||plan.dias.length===0){
        cal.style.display='none'; emp.style.display='flex';
        document.getElementById('statDias').textContent='0';
        document.getElementById('statTemas').textContent='0';
        return;
    }

    var tot=0; plan.dias.forEach(function(d){tot+=(d.temas||[]).length;});
    document.getElementById('statDias').textContent=plan.dias.length;
    document.getElementById('statTemas').textContent=tot;

    var html='';
    if(plan.resumen) html+='<div class="plan-resumen-global"><i class="bi bi-stars"></i>'+e(plan.resumen)+'</div>';

    var mesAct='';
    plan.dias.forEach(function(dia,idx){
        var fo=pf(dia.fecha);
        var mk=fo?(M[fo.getMonth()]+' '+fo.getFullYear()):'';
        var dn=fo?fo.getDate():(idx+1);
        var ds=dia.dia_semana||(fo?DC[fo.getDay()]:'');
        var mn=fo?M[fo.getMonth()]:'';

        if(mk&&mk!==mesAct){ mesAct=mk; html+='<div class="plan-mes-label"><i class="bi bi-calendar3"></i>'+e(mk)+'</div>'; }

        var temas=dia.temas||[];
        var tit=dia.titulo||('Día '+(idx+1));
        var dur=dia.duracion_estimada||'';
        var nc=dia.nivel==='alto'?'nivel-alto':dia.nivel==='medio'?'nivel-medio':'nivel-bajo';
        var nl=dia.nivel==='alto'?'Alta prioridad':dia.nivel==='medio'?'Media prioridad':'Repaso';

        html+='<div class="plan-day-card" data-idx="'+idx+'" style="animation-delay:'+(idx*.06)+'s">'
            +'<div class="plan-date-col">'
            +'<div class="plan-date-weekday">'+e(ds)+'</div>'
            +'<div class="plan-date-num">'+dn+'</div>'
            +'<div class="plan-date-month">'+e(mn)+'</div>'
            +'</div>'
            +'<div class="plan-day-right-col">'
            +'<div class="plan-day-header">'
            +'<div class="plan-day-titulo">'+e(tit)+'</div>'
            +'<div class="plan-day-meta">'
            +'<span class="plan-nivel-badge '+nc+'">'+nl+'</span>'
            +(dur?'<span class="plan-duracion"><i class="bi bi-clock"></i>'+e(dur)+'</span>':'')
            +'</div>'
            +'<button class="plan-check-btn" onclick="marcarDia(this,'+idx+')" title="Marcar completado"><i class="bi bi-check2"></i></button>'
            +'</div>'
            +'<div class="plan-day-body"><ul class="plan-temas-list">';

        temas.forEach(function(t){
            var dif=t.dificultad||'';
            var dc=dif==='alta'?'dif-alta':dif==='media'?'dif-media':'dif-baja';
            var rec=t.recursos||[];
            html+='<li class="plan-tema-item">'
                +'<div class="plan-tema-top"><span class="plan-tema-bullet"></span>'
                +'<span class="plan-tema-nombre">'+e(t.nombre||'')+'</span>'
                +(dif?'<span class="plan-dif-badge '+dc+'">'+e(dif)+'</span>':'')
                +'</div>';
            if(t.descripcion) html+='<p class="plan-tema-desc">'+e(t.descripcion)+'</p>';
            if(rec.length){
                html+='<div class="plan-recursos"><span class="plan-recursos-label"><i class="bi bi-book"></i>Recursos</span><ul class="plan-recursos-list">';
                rec.forEach(function(r){ html+='<li>'+e(r)+'</li>'; });
                html+='</ul></div>';
            }
            html+='</li>';
        });

        html+='</ul>';
        if(dia.recomendacion) html+='<div class="plan-day-rec"><i class="bi bi-lightbulb"></i><span>'+e(dia.recomendacion)+'</span></div>';
        html+='</div></div></div>';
    });

    cal.innerHTML=html;
    cargarEstado();

    function e(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
    function pf(s){if(!s)return null;var p=s.split('/');return p.length===3?new Date(+p[2],+p[1]-1,+p[0]):null;}
})();

function marcarDia(btn,idx){btn.closest('.plan-day-card').classList.toggle('completado');guardarEstado();actualizarContador();}
function guardarEstado(){var a=[];document.querySelectorAll('.plan-day-card').forEach(function(c){a.push(c.classList.contains('completado'));});try{localStorage.setItem('plan_@Model.Id',JSON.stringify(a));}catch(x){}}
function cargarEstado(){try{var r=localStorage.getItem('plan_@Model.Id');if(!r)return;JSON.parse(r).forEach(function(v,i){var c=document.querySelectorAll('.plan-day-card')[i];if(c&&v)c.classList.add('completado');});actualizarContador();}catch(x){}}
function actualizarContador(){var n=document.querySelectorAll('.plan-day-card.completado').length;var el=document.getElementById('statCompletados');if(el)el.textContent=n;}
    </script>
}
